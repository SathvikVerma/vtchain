# Google Gemini
GEMINI_API_KEY=

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB_NAME=vtchain

# GoDaddy ANS — real production registration (see README for how these
# three agents were provisioned via `ans-cli`). Ask Sathvik for the real
# values, or re-run the ans-cli flow yourself against your own domain.
ANS_API_BASE_URL=https://api.godaddy.com
ANS_API_KEY=your-godaddy-key:your-godaddy-secret
ANS_USE_MOCK=false

# Our real registered domain. Agent identities are anchored as subdomains of
# this: buyer.<domain>, seller.<domain>, auditor.<domain>.
ANS_ROOT_DOMAIN=brownsugar.design

# Real GoDaddy-assigned ANS agent UUIDs, one per role (from `ans-cli register`)
ANS_BUYER_AGENT_ID=
ANS_SELLER_AGENT_ID=
ANS_AUDITOR_AGENT_ID=

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_BUYER_KEYPAIR_PATH=./keys/buyer.json
SOLANA_SELLER_KEYPAIR_PATH=./keys/seller.json

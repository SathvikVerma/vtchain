# Google Gemini
GEMINI_API_KEY=

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB_NAME=vtchain

# GoDaddy ANS — fill in once real docs are confirmed
ANS_API_BASE_URL=
ANS_API_KEY=
ANS_USE_MOCK=true

# Our registered domain (from the free GoDaddy domain perk). Agent identities
# are anchored as subdomains of this: buyer.<domain>, seller.<domain>, etc.
ANS_ROOT_DOMAIN=vtchain.xyz

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_BUYER_KEYPAIR_PATH=./keys/buyer.json
SOLANA_SELLER_KEYPAIR_PATH=./keys/seller.json
